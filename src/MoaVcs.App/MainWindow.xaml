<Window x:Class="MoaVcs.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MoaVCS" Width="1370" Height="900" MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}"
 PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
 <Window.Resources>
  <DataTemplate x:Key="RepositoryRowTemplate">
   <Border CornerRadius="6" BorderThickness="1" Margin="1,1,2,3">
    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#28394E"/><Setter Property="BorderBrush" Value="#3B536C"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <Grid MinHeight="54">
     <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="#E45F3C" CornerRadius="2" Margin="0,8,0,8"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
     <Button x:Name="RepositoryOpenButton" Grid.Column="1" Tag="{Binding}" Click="RecentOpenMenu_Click" Background="Transparent" BorderThickness="0" Padding="7,5,2,5" HorizontalContentAlignment="Stretch" ToolTip="{Binding Path}">
      <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
       <MenuItem Header="열기" Tag="{Binding}" Click="RecentOpenMenu_Click"/><Separator/>
       <MenuItem Header="{Binding PinMenuLabel}" Tag="{Binding}" Click="RecentPin_Click"/>
       <MenuItem Header="목록에서 제거" Tag="{Binding}" ToolTip="이 목록과 상태 배지 감시 대상에서만 제거하며 로컬 파일은 유지합니다." Click="RecentRemove_Click"/>
      </ContextMenu></Button.ContextMenu>
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Name}" Foreground="#E4EAF1" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <Border Grid.Column="1" Background="#31445A" CornerRadius="3" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding KindLabel}" Foreground="#A9B9CB" FontSize="10"/></Border>
       <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ParentLabel}" Foreground="#9BAFC5" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
      </Grid>
     </Button>
     <Button x:Name="RepositoryItemMenuButton" Grid.Column="2" Tag="{Binding}" Content="⋯" FontSize="15" Width="26" Height="28" Padding="0" Background="Transparent" Foreground="#91A0B5" BorderThickness="0" ToolTip="저장소 목록 작업" Click="RepositoryItemMenu_Click">
      <Button.ContextMenu>
       <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="열기" Tag="{Binding}" Click="RecentOpenMenu_Click"/><Separator/>
        <MenuItem x:Name="RepositoryPinMenuItem" Header="{Binding PinMenuLabel}" Tag="{Binding}" Click="RecentPin_Click"/>
        <MenuItem x:Name="RepositoryRemoveMenuItem" Header="목록에서 제거" Tag="{Binding}" ToolTip="이 목록과 상태 배지 감시 대상에서만 제거하며 로컬 파일은 유지합니다." Click="RecentRemove_Click"/>
       </ContextMenu>
      </Button.ContextMenu>
     </Button>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="272"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#172434">
    <Grid Margin="16,26,16,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="7,0,0,32"><Border Background="#E45F3C" Width="33" Height="33" CornerRadius="10" Margin="0,0,11,0"><TextBlock Text="m" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-5,0,0"/></Border><TextBlock Text="moa" Foreground="White" FontSize="27" FontWeight="Bold"/><TextBlock Text="VCS" Foreground="#91A0B5" FontSize="16" Margin="3,7,0,0"/></StackPanel>
     <TextBlock Text="내 작업" Foreground="#91A0B5" FontSize="11" FontWeight="Bold" Margin="13,0,0,9"/>
     <Button x:Name="WorkspaceNav" Style="{StaticResource NavButton}" Background="#28394E" Foreground="White" Click="WorkspaceNav_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Margin="0,0,12,0"/><TextBlock Text="작업 공간"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Click="OpenFolder_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" Margin="0,0,12,0"/><TextBlock Text="저장소 열기"/></StackPanel></Button>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,24,0,10">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="6,0,4,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="저장소 목록" Foreground="#91A0B5" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button x:Name="RepositoryListMenuButton" Grid.Column="1" Content="⋯" FontSize="17" Width="28" Height="26" Padding="0" Background="Transparent" Foreground="#91A0B5" BorderThickness="0" ToolTip="저장소 목록 관리" Click="RepositoryItemMenu_Click">
       <Button.ContextMenu><ContextMenu><MenuItem x:Name="ClearRecentMenuItem" Header="최근 목록 비우기" Click="ClearRecent_Click" ToolTip="고정한 항목과 로컬 파일을 유지하고 최근 목록과 배지 감시 대상만 정리합니다."/></ContextMenu></Button.ContextMenu>
      </Button>
     </Grid>
     <Border Grid.Row="1" Background="#213247" BorderBrush="#30445A" BorderThickness="1" CornerRadius="6" Margin="2,0,2,12" Padding="8,1">
      <DockPanel>
       <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#8296B0" FontSize="12" VerticalAlignment="Center" Margin="1,0,7,0"/>
       <Grid>
        <TextBox x:Name="RepositorySearchBox" TextChanged="RepositorySearch_TextChanged" Background="Transparent" BorderThickness="0" Foreground="#E4EAF1" CaretBrush="White" FontSize="11" Padding="0,7" ToolTip="이름, 경로 또는 버전 관리 도구로 검색"/>
        <TextBlock Text="이름 또는 경로 검색" Foreground="#91A0B5" FontSize="11" IsHitTestVisible="False" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=RepositorySearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </Grid>
      </DockPanel>
     </Border>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock x:Name="PinnedHeading" Text="고정" Foreground="#91A0B5" FontSize="10" FontWeight="Bold" Margin="9,2,0,6" Visibility="Collapsed"/>
     <ItemsControl x:Name="PinnedList" ItemTemplate="{StaticResource RepositoryRowTemplate}"/>
     <TextBlock x:Name="RecentHeading" Text="최근" Foreground="#91A0B5" FontSize="10" FontWeight="Bold" Margin="9,8,0,6"/>
     <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource RepositoryRowTemplate}"/>
     <TextBlock x:Name="RepositoryListEmpty" Text="저장소가 없습니다.&#x0a;폴더를 열면 여기에 표시됩니다." TextWrapping="Wrap" Foreground="#91A0B5" FontSize="11" Margin="9,8" Visibility="Collapsed"/>
     <TextBlock x:Name="RepositorySearchEmpty" Text="검색 결과가 없습니다." Foreground="#91A0B5" FontSize="11" Margin="9,8" Visibility="Collapsed"/>
     </StackPanel></ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="3">
     <Button x:Name="SidebarSettingsButton" Style="{StaticResource NavButton}" Click="Settings_Click" ToolTip="버전 관리 도구, 비교·이력 도구, 탐색기 메뉴"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,12,0"/><TextBlock Text="설정"/></StackPanel></Button>
     <TextBlock x:Name="VersionText" Text="MoaVCS" Foreground="#5F738D" FontSize="10" Margin="13,14,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="30,22">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="YOUR WORK, CONNECTED" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="RepoTitle" Text="작업 공간" FontSize="25" FontWeight="SemiBold" MaxWidth="340" TextTrimming="CharacterEllipsis"/><Border x:Name="BranchBadge" Background="#EEF3F8" CornerRadius="4" Padding="9,4" Margin="12,4,0,2" Visibility="Collapsed"><TextBlock x:Name="BranchText" FontSize="11" Foreground="#52657D" MaxWidth="130" TextTrimming="CharacterEllipsis"/></Border></StackPanel><TextBlock x:Name="RepoPath" Text="사용할 저장소를 선택해 주세요." Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
     <Menu x:Name="WorkspaceMenu" Grid.Column="1" Background="Transparent" VerticalAlignment="Center" FontSize="13">
      <MenuItem Header="저장소 ▾" Padding="14,10">
       <MenuItem Header="저장소 폴더 열기…" InputGestureText="Ctrl+O" Click="OpenFolder_Click"/>
       <MenuItem x:Name="CreateButton" Header="새 저장소 만들기 / 복제…" Click="Create_Click"/>
       <Separator/>
       <MenuItem x:Name="RemoteButton" Header="원격 주소 설정…" Click="Remote_Click" Visibility="Collapsed"/>
       <MenuItem x:Name="ProviderMenu" Header="버전 관리 도구 변경" IsEnabled="False">
        <MenuItem Header="Git" Tag="Git" IsCheckable="True" Click="ProviderMenu_Click"/>
        <MenuItem Header="SVN" Tag="Svn" IsCheckable="True" Click="ProviderMenu_Click"/>
        <MenuItem Header="Perforce" Tag="Perforce" IsCheckable="True" Click="ProviderMenu_Click"/>
        <MenuItem Header="Lore" Tag="Lore" IsCheckable="True" Click="ProviderMenu_Click"/>
       </MenuItem>
      </MenuItem>
      <MenuItem x:Name="FileToolsMenu" Header="파일 도구 ▾" Padding="14,10" IsEnabled="False">
       <MenuItem x:Name="FileDiffButton" Header="선택 파일 비교 (Diff)" Click="FileDiff_Click"/>
       <MenuItem x:Name="ConflictMenu" Header="선택 파일의 충돌 해결…" Click="InternalDiff_Click"/>
       <MenuItem x:Name="FileBlameButton" Header="선택 파일의 행별 이력 (Blame)" Click="FileBlame_Click"/>
       <MenuItem Header="내장 도구로 열기">
        <MenuItem x:Name="InternalDiffMenu" Header="선택 파일 비교" Click="InternalDiff_Click"/>
        <MenuItem x:Name="InternalBlameMenu" Header="선택 파일의 행별 이력" Click="InternalBlame_Click"/>
       </MenuItem>
       <Separator/>
       <MenuItem x:Name="BrowseDiffButton" Header="다른 파일을 골라 비교…" Click="BrowseDiff_Click"/>
       <MenuItem x:Name="BrowseBlameButton" Header="다른 파일의 행별 이력…" Click="BrowseBlame_Click"/>
       <Separator/>
       <MenuItem Header="비교·이력 도구 설정…" Click="FileToolSettings_Click"/>
      </MenuItem>
     </Menu>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Margin="28,22,28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="NoticePanel" Visibility="Collapsed" Background="#FFF1E9" BorderBrush="#F1D0BE" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="NoticeText" Foreground="#9A4127" TextWrapping="Wrap" MaxHeight="90"/><Button Grid.Column="1" Content="×" Padding="8,0" Background="Transparent" BorderThickness="0" Click="DismissNotice_Click"/></Grid></Border>
    <Grid Grid.Row="1">
     <Grid x:Name="WelcomePanel">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="740" Margin="0,0,0,26">
       <Border Background="#FBE8DF" Width="58" Height="58" CornerRadius="17" HorizontalAlignment="Left" Margin="0,0,0,24"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" Foreground="{StaticResource Accent}" FontSize="27" HorizontalAlignment="Center"/></Border>
       <TextBlock Text="모든 버전 관리,&#x0a;하나의 작업 공간." FontSize="37" FontWeight="SemiBold" LineHeight="51"/>
       <TextBlock Text="저장소는 파일과 변경 이력을 함께 관리하는 폴더입니다.&#x0a;사용 중인 폴더를 열거나 새 저장소로 시작하세요." FontSize="15" LineHeight="25" Foreground="{StaticResource Muted}" Margin="0,18,0,26"/>
       <StackPanel Orientation="Horizontal"><Button Content="저장소 폴더 열기  →" Style="{StaticResource AccentButton}" Padding="20,12" Click="OpenFolder_Click"/><Button Content="새로 시작하기" Margin="12,0,0,0" Click="Create_Click"/></StackPanel>
       <UniformGrid Columns="3" Margin="0,36,0,0">
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="17,15" Margin="0,0,10,0"><StackPanel><TextBlock Text="1  변경 확인" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="바뀐 파일과 내용을&#x0a;살펴보세요." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0" LineHeight="21"/></StackPanel></Border>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="17,15" Margin="0,0,10,0"><StackPanel><TextBlock Text="2  기록 준비" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="함께 기록할 파일을&#x0a;선택하세요." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0" LineHeight="21"/></StackPanel></Border>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="17,15"><StackPanel><TextBlock Text="3  변경 기록" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="설명을 적고 커밋해&#x0a;작업 이력을 남기세요." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0" LineHeight="21"/></StackPanel></Border>
       </UniformGrid>
       <TextBlock Text="탐색기 우클릭으로도 바로 열 수 있습니다. 설정에서 메뉴를 등록하세요." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,20,0,0"/>
      </StackPanel>
     </Grid>
     <Grid x:Name="RepositoryPanel" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,16,0"><TextBlock x:Name="RepositoryKind" Text="저장소" FontWeight="SemiBold"/><TextBlock x:Name="RepositorySummary" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="UpdateButton" Content="↓  가져오기" Click="Update_Click" Margin="0,0,8,0" ToolTip="원격 저장소의 변경을 이 작업 공간에 적용합니다."/>
        <Button x:Name="PushButton" Content="↑  보내기" Click="Push_Click" Margin="0,0,8,0" ToolTip="기록한 커밋을 원격 저장소에 전송합니다."/>
        <Button x:Name="RefreshButton" Content="↻" Padding="12,9" Click="Refresh_Click" ToolTip="변경 파일 새로 고침 (F5)" AutomationProperties.Name="새로 고침"/>
       </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
       <TabControl x:Name="MainTabs" BorderThickness="0" Background="Transparent" Padding="0" Margin="1" SelectionChanged="MainTabs_SelectionChanged">
        <TabItem x:Name="ChangesTab" Header="변경 파일">
         <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Background="#F5F8FB" Padding="16,10" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><StackPanel><TextBlock x:Name="WorkflowTitle" Text="변경 내용을 확인하세요" FontWeight="SemiBold"/><TextBlock x:Name="WorkflowHint" Text="파일을 선택하면 오른쪽에서 바뀐 내용을 볼 수 있습니다." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="5*" MinWidth="300"/><ColumnDefinition Width="5"/><ColumnDefinition Width="6*" MinWidth="300"/></Grid.ColumnDefinitions>
           <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="14,12,14,8"><TextBlock x:Name="ChangeCount" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="변경된 파일" FontWeight="SemiBold"/></DockPanel>
            <WrapPanel Grid.Row="1" Margin="14,0,14,10"><Button x:Name="StageButton" Content="커밋에 포함" Padding="10,6" FontSize="12" Click="Stage_Click"/><Button x:Name="UnstageButton" Content="포함 해제" Padding="10,6" FontSize="12" Click="Unstage_Click" Margin="6,0,0,0"/></WrapPanel>
            <Grid Grid.Row="2"><DataGrid x:Name="ChangesGrid" SelectionChanged="ChangesGrid_SelectionChanged" SelectionMode="Extended" AutomationProperties.Name="변경된 파일 목록"><DataGrid.Columns><DataGridTextColumn Header="상태" Binding="{Binding Status, Converter={StaticResource FileStatusLabel}}" Width="100"/><DataGridTextColumn Header="파일" Binding="{Binding Path}" Width="*"/><DataGridTemplateColumn x:Name="StagedColumn" Header="커밋 포함" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="—"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding IsStaged}" Value="True"><Setter Property="Text" Value="포함됨"/><Setter Property="Foreground" Value="#26754E"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock x:Name="CleanMessage" Text="변경된 파일이 없습니다.&#x0a;파일을 수정하면 여기에 표시됩니다." TextAlignment="Center" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="25" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
            <TextBlock x:Name="SelectionHint" Grid.Row="3" Text="Ctrl / Shift로 여러 파일 선택" FontSize="11" Foreground="{StaticResource Muted}" Margin="14,8" TextWrapping="Wrap"/>
           </Grid>
           <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#F0F2F5"/>
           <Grid Grid.Column="2" Background="#FCFDFE"><Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="14,8"><CheckBox x:Name="StagedDiffCheck" Content="커밋할 내용" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" Checked="StagedDiff_Changed" Unchecked="StagedDiff_Changed" ToolTip="포함된 변경과 이전 커밋을 비교합니다."/><TextBlock x:Name="DiffTitle" Text="내용 미리 보기" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="좌우 비교와 행별 이력은 위쪽 ‘파일 도구’에서 열 수 있습니다."/></DockPanel>
            <RichTextBox x:Name="DiffViewer" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Background="#FCFDFE" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="14,10" FontFamily="Cascadia Mono, Consolas" FontSize="12"><FlowDocument><Paragraph Foreground="#8290A2">파일을 선택하면 변경 내용을 볼 수 있습니다.</Paragraph></FlowDocument></RichTextBox>
           </Grid>
          </Grid>
          <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#FCFCFD" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="변경 기록 남기기" FontWeight="SemiBold"/><TextBlock x:Name="CommitHint" Text="커밋에 포함할 파일을 먼저 선택하세요." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,8" TextWrapping="Wrap"/><Grid><TextBox x:Name="CommitMessage" MinHeight="53" MaxHeight="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="변경 내용을 설명하는 커밋 메시지" AutomationProperties.Name="변경 설명" TextChanged="CommitMessage_TextChanged"/><TextBlock Text="무엇을 바꿨나요? 예: 검색 결과 정렬 오류 수정" Foreground="{StaticResource Muted}" Margin="11,10" VerticalAlignment="Top" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CommitMessage}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></StackPanel><StackPanel Grid.Column="1" Margin="14,20,0,0" VerticalAlignment="Center"><Button x:Name="CommitButton" Content="커밋" Style="{StaticResource AccentButton}" Padding="22,12" Click="Commit_Click" ToolTip="변경 설명과 함께 기록합니다 (Ctrl+Enter)."/><TextBlock x:Name="CommitDestinationHint" Text="이 PC에 기록" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Grid></Border>
         </Grid>
        </TabItem>
        <TabItem x:Name="HistoryTab" Header="커밋 이력">
         <Grid>
          <Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="150"/><RowDefinition Height="6"/><RowDefinition Height="3*" MinHeight="260"/></Grid.RowDefinitions>
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <DataGrid x:Name="HistoryGrid" SelectionMode="Single" RowHeight="34" SelectionChanged="HistoryGrid_SelectionChanged" AutomationProperties.Name="커밋 이력 목록">
            <DataGrid.Columns>
             <DataGridTextColumn Header="리비전" Binding="{Binding Id}" Width="130"/>
             <DataGridTextColumn Header="메시지" Binding="{Binding Summary}" Width="*">
              <DataGridTextColumn.ElementStyle>
               <Style TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="ToolTip" Value="{Binding Message}"/>
               </Style>
              </DataGridTextColumn.ElementStyle>
             </DataGridTextColumn>
             <DataGridTextColumn Header="작성자" Binding="{Binding Author}" Width="150"/>
             <DataGridTextColumn Header="날짜" Binding="{Binding Date}" Width="190"/>
            </DataGrid.Columns>
           </DataGrid>
           <TextBlock Grid.Row="1" x:Name="HistoryHint" Text="최근 기록" FontSize="11" Foreground="{StaticResource Muted}" Margin="15,8"/>
          </Grid>
          <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#F0F2F5"/>
          <Grid Grid.Row="2">
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <Border Padding="14,10" Background="#F7F9FC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
             <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
             <DockPanel>
              <TextBlock x:Name="HistoryDetailStatus" DockPanel.Dock="Right" Text="커밋을 선택하면 변경 파일과 내용을 볼 수 있습니다." FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
              <TextBox x:Name="HistoryDetailRevision" Text="커밋 세부 내역" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontWeight="SemiBold" TextWrapping="NoWrap" MaxWidth="270" HorizontalAlignment="Left" HorizontalContentAlignment="Left" ToolTip="전체 리비전을 선택해 복사할 수 있습니다."/>
             </DockPanel>
             <StackPanel Grid.Row="1" Margin="0,6,0,0">
              <TextBlock x:Name="HistoryDetailMetadata" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
              <TextBox x:Name="HistoryDetailMessage" Margin="0,5,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="76" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="전체 커밋 메시지" ToolTip="전체 메시지를 선택해 복사할 수 있습니다."/>
              <TextBlock x:Name="HistoryComparisonLabel" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
             </StackPanel>
            </Grid>
           </Border>
           <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#F0F2F5"/>
           <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="190"/><ColumnDefinition Width="5"/><ColumnDefinition Width="5*" MinWidth="250"/></Grid.ColumnDefinitions>
            <Grid>
             <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
             <TextBlock Text="변경 파일" FontWeight="SemiBold" FontSize="12" Margin="14,10,10,8"/>
             <DataGrid x:Name="HistoryFilesGrid" Grid.Row="1" SelectionMode="Single" SelectionChanged="HistoryFilesGrid_SelectionChanged" AutomationProperties.Name="커밋 변경 파일">
              <DataGrid.Columns>
               <DataGridTextColumn Header="상태" Binding="{Binding Status, Converter={StaticResource FileStatusLabel}}" Width="82"/>
               <DataGridTextColumn Header="파일" Binding="{Binding Path}" Width="*"/>
              </DataGrid.Columns>
             </DataGrid>
             <TextBlock x:Name="HistoryFilesEmpty" Grid.Row="1" Text="커밋을 선택하면 변경 파일이 표시됩니다." TextAlignment="Center" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12" IsHitTestVisible="False"/>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#F0F2F5"/>
            <Grid Grid.Column="2" Background="#FCFDFE">
             <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
             <DockPanel Margin="14,10,14,8"><TextBlock x:Name="HistoryDiffPath" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="커밋 변경 내용" FontWeight="SemiBold" FontSize="12"/></DockPanel>
             <RichTextBox x:Name="HistoryDiffViewer" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" Background="#FCFDFE" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="14,10" FontFamily="Cascadia Mono, Consolas" FontSize="12"><FlowDocument><Paragraph Foreground="#8290A2">파일을 선택하면 이 커밋의 변경 내용이 표시됩니다.</Paragraph></FlowDocument></RichTextBox>
            </Grid>
           </Grid>
          </Grid>
         </Grid>
        </TabItem>
        <TabItem x:Name="OutputTab" Header="실행 기록"><TextBox x:Name="OutputLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F9FAFC" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="1"/></TabItem>
       </TabControl>
      </Border>
     </Grid>
    </Grid>
   </Grid>
   <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="White" Padding="28,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CancelButton" Content="작업 중지" Padding="7,2" FontSize="10" Visibility="Collapsed" Click="Cancel_Click" Margin="0,0,12,0"/><TextBlock Text="Ctrl+O  열기     F5  새로 고침" FontSize="10" Foreground="#95A0AE"/></StackPanel><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#4FA889" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="준비됨" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
