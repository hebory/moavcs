<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Original 24-unit vectors. Keep their silhouettes distinct at 16 pixels. -->
  <Canvas x:Key="commit" Width="24" Height="24">
    <Path Data="M 5,2 V 22" Stroke="#D95836" StrokeThickness="2.5"/>
    <Ellipse Canvas.Left="2" Canvas.Top="8" Width="6" Height="6" Fill="#D95836"/>
    <Path Data="M 11,13 L 15,17 L 22,7" Stroke="#21986A" StrokeThickness="3"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
  </Canvas>
  <Canvas x:Key="update" Width="24" Height="24">
    <Path Data="M 12,2 V 15 M 6,9 L 12,15 L 18,9" Stroke="#3685D6" StrokeThickness="2.6"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
    <Path Data="M 3,16 V 21 H 21 V 16" Stroke="#70859B" StrokeThickness="2.4" StrokeLineJoin="Round"/>
  </Canvas>
  <Canvas x:Key="push" Width="24" Height="24">
    <Path Data="M 12,16 V 3 M 6,9 L 12,3 L 18,9" Stroke="#D95836" StrokeThickness="2.6"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
    <Path Data="M 3,16 V 21 H 21 V 16" Stroke="#70859B" StrokeThickness="2.4" StrokeLineJoin="Round"/>
  </Canvas>
  <Canvas x:Key="log" Width="24" Height="24">
    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Stroke="#9270C5" StrokeThickness="2.5"/>
    <Path Data="M 12,6 V 12 L 17,15" Stroke="#9270C5" StrokeThickness="2.5"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
  </Canvas>
  <Canvas x:Key="status" Width="24" Height="24">
    <Path Data="M 10,5 H 22 M 10,12 H 22 M 10,19 H 22" Stroke="#70859B" StrokeThickness="2.4"/>
    <Path Data="M 2,5 L 4,7 L 7,3" Stroke="#21986A" StrokeThickness="2.2" StrokeLineJoin="Round"/>
    <Ellipse Canvas.Left="2" Canvas.Top="10" Width="4" Height="4" Fill="#D99522"/>
    <Path Data="M 2,17 L 6,21 M 6,17 L 2,21" Stroke="#D95836" StrokeThickness="2"/>
  </Canvas>
  <Canvas x:Key="open" Width="24" Height="24">
    <Path Data="M 2,5 Q 2,3 4,3 H 9 L 12,6 H 20 Q 22,6 22,8 V 20 H 2 Z" Fill="#D99522"/>
    <Path Data="M 2,10 H 22 L 19,21 H 2 Z" Fill="#F1BA52"/>
    <Path Data="M 6,15 H 16 M 13,12 L 16,15 L 13,18" Stroke="#805D22" StrokeThickness="2" StrokeLineJoin="Round"/>
  </Canvas>
  <Canvas x:Key="clone" Width="24" Height="24">
    <Path Data="M 2,15 V 3 H 13 V 6 M 6,18 V 7 H 17 V 10" Stroke="#37A49A" StrokeThickness="2.2" StrokeLineJoin="Round"/>
    <Rectangle Canvas.Left="10" Canvas.Top="11" Width="11" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="#37A49A"/>
    <Path Data="M 13,15 H 18 M 13,18 H 18" Stroke="White" StrokeThickness="1.5"/>
  </Canvas>
  <Canvas x:Key="init" Width="24" Height="24">
    <Path Data="M 2,5 Q 2,3 4,3 H 9 L 12,6 H 20 Q 22,6 22,8 V 21 H 2 Z" Fill="#D99522"/>
    <Path Data="M 2,10 H 22 V 21 H 2 Z" Fill="#F1BA52"/>
    <Ellipse Canvas.Left="10" Canvas.Top="10" Width="14" Height="14" Fill="#21986A"/>
    <Path Data="M 17,13 V 21 M 13,17 H 21" Stroke="White" StrokeThickness="2"/>
  </Canvas>
  <Canvas x:Key="remote" Width="24" Height="24">
    <Path Data="M 10,15 L 8,17 A 4,4 0 0 1 2,11 L 7,6 A 4,4 0 0 1 13,6 M 14,9 L 16,7 A 4,4 0 0 1 22,13 L 17,18 A 4,4 0 0 1 11,18 M 8,12 H 16"
          Stroke="#3685D6" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
  </Canvas>
  <Canvas x:Key="settings" Width="24" Height="24">
    <Path Data="M 9,2 H 15 L 16,5 L 19,6 L 22,9 V 15 L 19,16 L 18,19 L 15,22 H 9 L 8,19 L 5,18 L 2,15 V 9 L 5,8 L 6,5 Z"
          Fill="#70859B"/>
    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Fill="#F3F6FA"/>
    <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="#70859B"/>
  </Canvas>
  <Canvas x:Key="diff" Width="24" Height="24">
    <Rectangle Canvas.Left="2" Canvas.Top="3" Width="8" Height="18" RadiusX="1" RadiusY="1" Stroke="#D95836" StrokeThickness="1.8"/>
    <Rectangle Canvas.Left="14" Canvas.Top="3" Width="8" Height="18" RadiusX="1" RadiusY="1" Stroke="#21986A" StrokeThickness="1.8"/>
    <Path Data="M 4,9 H 8" Stroke="#D95836" StrokeThickness="2"/>
    <Path Data="M 16,9 H 20 M 18,7 V 11" Stroke="#21986A" StrokeThickness="2"/>
    <Path Data="M 4,16 H 8 M 16,16 H 20" Stroke="#70859B" StrokeThickness="1.8"/>
  </Canvas>
  <Canvas x:Key="blame" Width="24" Height="24">
    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="7" Height="7" Fill="#9270C5"/>
    <Path Data="M 1,19 V 16 Q 1,12 6.5,12 Q 12,12 12,16 V 19 Z" Fill="#9270C5"/>
    <Path Data="M 15,6 H 23 M 15,12 H 23 M 15,18 H 23" Stroke="#70859B" StrokeThickness="2.4"/>
  </Canvas>
</ResourceDictionary>
